# Copy to .env.local for development or .env.production on the Hostinger VPS.
MYSQL_HOST=your-hostinger-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=TeakwoodProduction
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# App URL used in links and deployment checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public browser origin for WhiteBooks requests behind a reverse proxy.
# Leave empty for direct connections; include the public port when configured.
APP_ORIGIN=
# Multiple public addresses: APP_ORIGIN=http://your-host:4000,http://your-host:8000

# Required before enabling login sessions in production.
APP_SESSION_SECRET=change-this-to-a-long-random-string
AUTH_SESSION_HOURS=8

# WhiteBooks e-invoice sandbox. Server-only values; never use NEXT_PUBLIC_ prefixes.
WHITEBOOKS_EMAIL=
WHITEBOOKS_USERNAME=
WHITEBOOKS_PASSWORD=
WHITEBOOKS_IP_ADDRESS=
WHITEBOOKS_CLIENT_ID=
WHITEBOOKS_CLIENT_SECRET=
WHITEBOOKS_GSTIN=

# Optional. Required only for "Update Available Stock" Tranzact action.
TRANZACT_LOGIN_URL=https://be.letstranzact.com/main/login/password-login/
TRANZACT_BASE_URL=https://be.letstranzact.com
TRANZACT_EMAIL=your_tranzact_email
TRANZACT_PASSWORD=your_tranzact_password
TRANZACT_MAX_RETRIES=5
TRANZACT_PAGE_DELAY_MS=1500

# Dropbox OAuth. Keep the app secret on the server only.
# Register this exact redirect URI in Dropbox App Console > Settings > OAuth 2.
DROPBOX_APP_KEY=3yjzkr3ox3olsub
DROPBOX_APP_SECRET=u6atn4v0c1ih5bu
DROPBOX_REDIRECT_URI=http://localhost:3000/api/dropbox/oauth/callback

# Optional fallback if authentication does not return an IRP identifier.
WHITEBOOKS_IRP=

# E-invoice production credentials. Set WHITEBOOKS_EINVOICE_ENV=production to use them.
WHITEBOOKS_PRODUCTION_BASE_URL=https://api.whitebooks.in
WHITEBOOKS_PRODUCTION_CLIENT_ID=
WHITEBOOKS_PRODUCTION_CLIENT_SECRET=

# Active e-invoice environment; standalone e-way bills keep their sandbox settings.
WHITEBOOKS_EINVOICE_ENV=sandbox
WHITEBOOKS_PRODUCTION_USERNAME=
WHITEBOOKS_PRODUCTION_PASSWORD=
WHITEBOOKS_PRODUCTION_GSTIN=
WHITEBOOKS_PRODUCTION_EMAIL=
WHITEBOOKS_PRODUCTION_IP_ADDRESS=

# Separate e-way bill production account. No fallback to e-invoice client credentials.
WHITEBOOKS_EWAYBILL_ENV=sandbox
WHITEBOOKS_EWAYBILL_PRODUCTION_BASE_URL=https://api.whitebooks.in
WHITEBOOKS_EWAYBILL_PRODUCTION_CLIENT_ID=
WHITEBOOKS_EWAYBILL_PRODUCTION_CLIENT_SECRET=
WHITEBOOKS_EWAYBILL_PRODUCTION_USERNAME=
WHITEBOOKS_EWAYBILL_PRODUCTION_PASSWORD=
WHITEBOOKS_EWAYBILL_PRODUCTION_EMAIL=
WHITEBOOKS_EWAYBILL_PRODUCTION_GSTIN=
WHITEBOOKS_EWAYBILL_PRODUCTION_IP_ADDRESS=
WHITEBOOKS_EWAYBILL_PRODUCTION_IRP=
